generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String        @id @default(uuid())
  email        String        @unique
  password     String
  role         Role
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  deletedAt    DateTime?
  address      String?
  city         String?
  country      String?
  phone        String?
  state        String?
  authSessions AuthSession[]
  coach        Coach?
  school       School?

  @@index([role])
}

model AuthSession {
  id               String    @id @default(uuid())
  userId           String
  familyId         String
  refreshTokenHash String    @unique
  userAgent        String?
  ipAddress        String?
  expiresAt        DateTime
  revokedAt        DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@index([userId, revokedAt])
}

model School {
  id                         String                      @id @default(uuid())
  name                       String
  userId                     String                      @unique
  createdAt                  DateTime                    @default(now())
  updatedAt                  DateTime                    @updatedAt
  deletedAt                  DateTime?
  character                  Character
  headquarters               String?
  representativename         String?
  website                    String?
  city                       String?
  country                    String
  foundationDate             DateTime?
  institutionType            InstitutionType?
  latitude                   Float?
  logo                       String?
  longitude                  Float?
  state                      String?
  taxId                      String?                     @unique
  representativeDocumentType RepresentativeDocumentType?
  athletes                   AthleteInstitution[]
  categories                 Category[]
  coaches                    Coach[]
  athleteDisciplines         Discipline[]
  user                       User                        @relation(fields: [userId], references: [id])
  disciplines                SchoolDiscipline[]
  plans                      SchoolPlan[]

  @@index([deletedAt])
}

model Coach {
  id         String          @id @default(uuid())
  name       String
  specialty  String
  userId     String          @unique
  schoolId   String
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt
  deletedAt  DateTime?
  athletes   Athlete[]
  school     School          @relation(fields: [schoolId], references: [id])
  user       User            @relation(fields: [userId], references: [id])
  categories CoachCategory[]

  @@index([schoolId])
  @@index([deletedAt])
}

model Athlete {
  id                    String               @id @default(uuid())
  coachId               String?
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt
  deletedAt             DateTime?
  birthCityId           String
  birthCountryId        String
  birthDate             DateTime
  birthDepartmentId     String
  categoryId            String
  documentNumber        String
  documentTypeId        String
  educationInstitution  String?
  educationLevelId      String
  email                 String               @unique
  firstName             String
  genderId              String
  height                Float
  lastName              String
  phone                 String?
  residenceCityId       String
  residenceCountryId    String
  residenceDepartmentId String
  weight                Float
  birthCity             City                 @relation("AthleteBirthCity", fields: [birthCityId], references: [id])
  birthCountry          Country              @relation("AthleteBirthCountry", fields: [birthCountryId], references: [id])
  birthDepartment       Department           @relation("AthleteBirthDepartment", fields: [birthDepartmentId], references: [id])
  category              Category             @relation(fields: [categoryId], references: [id])
  coach                 Coach?               @relation(fields: [coachId], references: [id])
  documentType          DocumentType         @relation(fields: [documentTypeId], references: [id])
  educationLevel        EducationLevel       @relation(fields: [educationLevelId], references: [id])
  gender                Gender               @relation(fields: [genderId], references: [id])
  residenceCity         City                 @relation("AthleteResidenceCity", fields: [residenceCityId], references: [id])
  residenceCountry      Country              @relation("AthleteResidenceCountry", fields: [residenceCountryId], references: [id])
  residenceDepartment   Department           @relation("AthleteResidenceDepartment", fields: [residenceDepartmentId], references: [id])
  disciplines           AthleteDiscipline[]
  institutions          AthleteInstitution[]

  @@unique([documentTypeId, documentNumber])
  @@index([documentTypeId])
  @@index([genderId])
  @@index([birthCountryId])
  @@index([birthDepartmentId])
  @@index([birthCityId])
  @@index([residenceCountryId])
  @@index([residenceDepartmentId])
  @@index([residenceCityId])
  @@index([educationLevelId])
  @@index([categoryId])
  @@index([coachId])
  @@index([deletedAt])
}

model Plan {
  id                  String       @id @default(uuid())
  createdAt           DateTime     @default(now())
  deletedAt           DateTime?
  description         String
  name                String       @unique
  price               Float
  updatedAt           DateTime     @updatedAt
  billingPeriodMonths Int          @default(1)
  isActive            Boolean      @default(true)
  maxAthletes         Int?
  maxCoaches          Int?
  schools             SchoolPlan[]
}

model SchoolPlan {
  id         String             @id @default(uuid())
  schoolId   String
  planId     String
  startDate  DateTime
  endDate    DateTime
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt
  deletedAt  DateTime?
  canceledAt DateTime?
  status     SubscriptionStatus @default(ACTIVE)
  plan       Plan               @relation(fields: [planId], references: [id])
  school     School             @relation(fields: [schoolId], references: [id])

  @@index([deletedAt])
  @@index([planId])
  @@index([schoolId])
}

model SportDiscipline {
  id          String             @id @default(uuid())
  name        String             @unique
  description String?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  deletedAt   DateTime?
  schools     SchoolDiscipline[]
}

model SchoolDiscipline {
  id           String          @id @default(uuid())
  schoolId     String
  disciplineId String
  assignedAt   DateTime        @default(now())
  discipline   SportDiscipline @relation(fields: [disciplineId], references: [id])
  school       School          @relation(fields: [schoolId], references: [id])

  @@unique([schoolId, disciplineId])
  @@index([schoolId])
  @@index([disciplineId])
}

model Category {
  id        String          @id @default(uuid())
  name      String
  schoolId  String
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  deletedAt DateTime?
  maxAge    Int?
  minAge    Int?
  athletes  Athlete[]
  school    School          @relation(fields: [schoolId], references: [id])
  coaches   CoachCategory[]

  @@unique([name, schoolId])
  @@index([schoolId])
  @@index([deletedAt])
}

model CoachCategory {
  id         String   @id @default(uuid())
  coachId    String
  categoryId String
  assignedAt DateTime @default(now())
  category   Category @relation(fields: [categoryId], references: [id])
  coach      Coach    @relation(fields: [coachId], references: [id])

  @@unique([coachId, categoryId])
  @@index([coachId])
  @@index([categoryId])
}

model DocumentType {
  id        String    @id @default(uuid())
  code      String    @unique
  name      String    @unique
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  athletes  Athlete[]

  @@index([deletedAt])
}

model Gender {
  id        String    @id @default(uuid())
  code      String    @unique
  name      String    @unique
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  athletes  Athlete[]

  @@index([deletedAt])
}

model Country {
  id                String       @id @default(uuid())
  code              String       @unique
  name              String       @unique
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  deletedAt         DateTime?
  birthAthletes     Athlete[]    @relation("AthleteBirthCountry")
  residenceAthletes Athlete[]    @relation("AthleteResidenceCountry")
  departments       Department[]

  @@index([deletedAt])
}

model Department {
  id                String    @id @default(uuid())
  name              String
  countryId         String
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  deletedAt         DateTime?
  birthAthletes     Athlete[] @relation("AthleteBirthDepartment")
  residenceAthletes Athlete[] @relation("AthleteResidenceDepartment")
  cities            City[]
  country           Country   @relation(fields: [countryId], references: [id])

  @@unique([name, countryId])
  @@index([countryId])
  @@index([deletedAt])
}

model City {
  id                String     @id @default(uuid())
  name              String
  departmentId      String
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt
  deletedAt         DateTime?
  birthAthletes     Athlete[]  @relation("AthleteBirthCity")
  residenceAthletes Athlete[]  @relation("AthleteResidenceCity")
  department        Department @relation(fields: [departmentId], references: [id])

  @@unique([name, departmentId])
  @@index([departmentId])
  @@index([deletedAt])
}

model EducationLevel {
  id        String    @id @default(uuid())
  code      String    @unique
  name      String    @unique
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  athletes  Athlete[]

  @@index([deletedAt])
}

model Discipline {
  id        String              @id @default(uuid())
  name      String
  schoolId  String
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt
  deletedAt DateTime?
  athletes  AthleteDiscipline[]
  school    School              @relation(fields: [schoolId], references: [id])

  @@unique([name, schoolId])
  @@index([schoolId])
  @@index([deletedAt])
}

model AthleteDiscipline {
  id           String     @id @default(uuid())
  athleteId    String
  disciplineId String
  assignedAt   DateTime   @default(now())
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  athlete      Athlete    @relation(fields: [athleteId], references: [id], onDelete: Cascade)
  discipline   Discipline @relation(fields: [disciplineId], references: [id])

  @@unique([athleteId, disciplineId])
  @@index([athleteId])
  @@index([disciplineId])
}

model AthleteInstitution {
  id         String   @id @default(uuid())
  athleteId  String
  schoolId   String
  assignedAt DateTime @default(now())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  athlete    Athlete  @relation(fields: [athleteId], references: [id], onDelete: Cascade)
  school     School   @relation(fields: [schoolId], references: [id])

  @@unique([athleteId, schoolId])
  @@index([athleteId])
  @@index([schoolId])
}

enum Role {
  ADMIN
  SCHOOL
  COACH
  ATHLETE
}

enum Character {
  PUBLIC
  PRIVATE
}

enum InstitutionType {
  CLUB
  ACADEMY
  FEDERATION
  ASSOCIATION
  SCHOOL
  OTHER
}

enum SubscriptionStatus {
  ACTIVE
  SCHEDULED
  CANCELED
  EXPIRED
}

enum RepresentativeDocumentType {
  CC
  CE
  NIT
  TI
  PA
}
